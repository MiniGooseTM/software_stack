<mujoco model="self_balancing_robot">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.004" gravity="0 0 -9.81" integrator="RK4"/>
  <size njmax="1000" nconmax="200"/>

  <default>
    <joint damping="0.08" armature="0.01"/>
    <geom friction="0.8 0.1 0.1" condim="3"/>
    <motor ctrlrange="-1 1" ctrllimited="true"/>
  </default>

  <asset>
    <material name="chassis_material" rgba="0.12 0.25 0.65 1"/>
    <material name="wheel_material" rgba="0.05 0.05 0.05 1"/>
    <material name="ground_material" rgba="0.35 0.35 0.35 1"/>
  </asset>

  <worldbody>
    <light name="key" pos="0 -2 4" directional="true"/>
    <geom name="ground" type="plane" size="20 20 0.1" material="ground_material"/>
    <body name="axle" pos="0 0 0.16">
      <joint name="x_slide" type="slide" axis="1 0 0" limited="false"/>
      <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
      <body name="chassis">
        <joint name="pitch" type="hinge" axis="0 1 0" limited="false"/>
        <geom name="chassis_geom" pos="0 0 0.28" type="box" size="0.22 0.14 0.28" mass="2.0" material="chassis_material"/>
      </body>
      <body name="left_wheel" pos="0 0.16 0">
        <joint name="left_wheel_hinge" type="hinge" axis="0 1 0"/>
        <geom name="left_wheel_geom" type="cylinder" size="0.16 0.04" mass="0.25" euler="90 0 0" material="wheel_material"/>
      </body>
      <body name="right_wheel" pos="0 -0.16 0">
        <joint name="right_wheel_hinge" type="hinge" axis="0 1 0"/>
        <geom name="right_wheel_geom" type="cylinder" size="0.16 0.04" mass="0.25" euler="90 0 0" material="wheel_material"/>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="chassis" body2="left_wheel"/>
    <exclude body1="chassis" body2="right_wheel"/>
  </contact>

  <actuator>
    <motor name="left_motor" joint="left_wheel_hinge" gear="1.0"/>
    <motor name="right_motor" joint="right_wheel_hinge" gear="1.0"/>
  </actuator>
</mujoco>
