<mujoco model="MiniGoose TM test">

    <compiler   angle="radian" 
                eulerseq="XYZ" 
                inertiafromgeom="false" />

    <option timestep="0.005"
          gravity="0 0 -9.81"
          integrator="implicitfast"/>
   
    <include file="goose.xml"/>
    <visual>
        <headlight ambient="0.3 0.3 0.3" diffuse="0.7 0.7 0.7"/>
    </visual>
    <!-- Scale all meshes to meters -->
    <asset>
                <!-- Use simple gradient for sky texture -->
        <texture type="skybox"
                builtin="gradient"
                rgb1="0.5 0.7 1"
                rgb2="0.95 0.95 1"
                width="256"
                height="256"/>

        <texture type="2d" name="floor" builtin="checker" mark="edge" rgb1="0.8 0.8 0.3" rgb2="0.2 0.5 0.2"
        markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="floor" texture="floor" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    </asset>

    <worldbody>
        <geom name="ground"
          type="plane"
          size="5 5 0.1"
          material="floor"/>

    </worldbody>

   
</mujoco>